# WhatsApp Business API Configuration
# Copy this file to .env and fill in your actual values

# WhatsApp Business API Credentials
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token_here

# Business Configuration
BUSINESS_PHONE_NUMBER=+918667018453
BUSINESS_NAME=IT Connect

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Database Configuration (if needed for message logging)
# DATABASE_URL=your_database_url_here

# Instructions:
# 1. Get your WhatsApp Business API credentials from Meta Business
# 2. Replace the placeholder values with your actual credentials
# 3. Rename this file to .env
# 4. Never commit the .env file to version control
